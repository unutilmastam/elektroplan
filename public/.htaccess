# ELEKTROPLAN — static Next.js export on cPanel (Apache)
Options -Indexes -MultiViews
DirectoryIndex index.html
AddDefaultCharset utf-8

RewriteEngine On

# 1. Force HTTPS (PWA + service worker require it)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. API is handled by api/.htaccess -> api/index.php
RewriteRule ^api(/.*)?$ - [L]

# 3. trailingSlash: true -> /projects -> /projects/ (folder with index.html)
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [L,R=301]

# 4. Unknown paths -> static 404 page
ErrorDocument 404 /404.html

# 5. MIME types
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# 6. Cache headers
<IfModule mod_headers.c>
  <FilesMatch "\.(html|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^sw\.js$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>
